' simulated_biofeedback.bi - the SIMULATED biofeedback engine and a small
' abstraction for possible future signal sources.
'
' IMPORTANT: Calm Garden has no physiological sensors. Every value produced by
' the built-in source is generated by the program from:
'   * the guided breathing pacer (phase and chosen rhythm),
'   * the user's mouse/keyboard interaction (the "focus" game),
'   * the user's own self-reported calmness,
'   * exercise time, and mathematical demonstration waveforms.
' None of it measures heart rate, stress, muscle tension or brain activity, and
' the "calm" value is NOT an objective measure of anyone's emotional state.
' Samples carry isMeasurement = 0 so that no view can present them as real data.
'
' Future sensors: a source registers a read function with Bio_RegisterSource().
' Hardware is never required; the simulation is always available as source 0.
#pragma once

Type BioSample
    t As Double             ' seconds since the session started
    breath As Single        ' -1 .. 1   breathing pacer waveform (guidance, not a measurement)
    heartDemo As Single     ' -1 .. 1   heart-LIKE demonstration waveform
    heartRateDemo As Single ' beats/min used to draw the demo waveform (invented)
    calm As Single          ' 0 .. 100  relaxation ANIMATION meter (simulated)
    focus As Single         ' 0 .. 100  focus game score (simulated)
    isMeasurement As Long   ' always 0 for the simulation
End Type

Type BioInputs
    breathAmount As Single  ' 0..1 from the pacer (animation.bas)
    breathing As Long       ' 1 while the guided pacer runs
    selfReport As Long      ' 0 = not given, 1..5 = the user's own rating
    pointerInside As Long   ' 1 while the pointer stays in the focus circle
    activity As Single      ' 0..1 amount of hurried input this frame
    paused As Long
End Type

Type BioReadFn As Function(ByVal ctx As Any Ptr, ByRef s As BioSample) As Long

Const BIO_HIST = 600        ' 20 s at 30 samples per second

Type BioHistory
    breath(0 To BIO_HIST - 1) As Single
    heart(0 To BIO_HIST - 1) As Single
    calm(0 To BIO_HIST - 1) As Single
    focus(0 To BIO_HIST - 1) As Single
    head As Long
    count As Long
End Type

Declare Sub Bio_Reset(ByVal seed As ULong = 12345)
' advances the simulation by dt seconds and returns the newest sample
Declare Sub Bio_Step(ByVal dt As Single, ByRef bioIn As BioInputs, ByRef outS As BioSample)
Declare Function Bio_History() As BioHistory Ptr
Declare Function Bio_HistGet(ByRef h As BioHistory, ByVal which As Long, ByVal ageIdx As Long) As Single
' heart-like demonstration shape for a phase 0..1 (P wave, QRS, T wave)
Declare Function Bio_HeartShape(ByVal ph As Single) As Single

' ---- signal sources ----
Declare Function Bio_SourceCount() As Long
Declare Function Bio_SourceName(ByVal i As Long) As String
Declare Function Bio_SourceIsSimulated(ByVal i As Long) As Boolean
Declare Function Bio_SourceConnected(ByVal i As Long) As Boolean
Declare Function Bio_RegisterSource(ByRef nm As String, ByVal fn As BioReadFn, ByVal ctx As Any Ptr) As Long
Declare Function Bio_ActiveSource() As Long
Declare Function Bio_ReadSource(ByVal i As Long, ByRef s As BioSample) As Boolean
